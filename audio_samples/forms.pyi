"""Array forms and extra options of common operations."""

from __future__ import annotations

import os
from typing import Any, Iterator, Optional, Union

import numpy as np
from numpy.typing import NDArray

def to_mono(*signals: NDArray[Any], pad: bool = True, norm: bool = True, out: Optional[NDArray[Any]] = None) -> NDArray[Any]: ...
def to_stereo(*, left: Optional[NDArray[Any]], right: Optional[NDArray[Any]], downmix: bool = True, pad: bool = True, norm: bool = True, out: Optional[NDArray[Any]] = None) -> NDArray[Any]: ...
def to_multi(*signals: NDArray[Any], downmix: bool = True, pad: bool = True, norm: bool = True, out: Optional[NDArray[Any]] = None) -> NDArray[Any]: ...
