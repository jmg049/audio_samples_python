def istft(stft_matrix: NDArray[Any], *, hop_length: Optional[int] = None, win_length: Optional[int] = None, n_fft: Optional[int] = None, window: Any = "hann", center: bool = True, length: Optional[int] = None, out: Optional[NDArray[Any]] = None) -> NDArray[Any]: ...
