def read_segment(path: Union[str, os.PathLike[str]], *, offset: float = 0.0, duration: Optional[float] = None, **kwargs: Any) -> Any: ...
def stream_blocks(path: Union[str, os.PathLike[str]], *, block_length: int, frame_length: int, hop_length: int, sr: Optional[int] = None, mono: bool = False, offset: float = 0.0, duration: Optional[float] = None, fill_value: Optional[float] = None, res_type: str = "soxr_hq") -> Iterator[NDArray[Any]]: ...
