def onset_strength(*, y: Optional[NDArray[Any]] = None, sr: float = 22050, S: Optional[NDArray[Any]] = None, lag: int = 1, max_size: int = 1, ref: Optional[NDArray[Any]] = None, detrend: bool = False, center: bool = True, feature: Any = None, n_fft: int = 2048, hop_length: int = 512, **kwargs: Any) -> NDArray[Any]: ...
