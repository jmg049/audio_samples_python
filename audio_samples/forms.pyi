def beat_track(*, y: Optional[NDArray[Any]] = None, sr: float = 22050, onset_envelope: Optional[NDArray[Any]] = None, hop_length: int = 512, sparse: bool = True, **kwargs: Any) -> tuple[Any, NDArray[Any]]: ...
