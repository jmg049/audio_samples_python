def chroma_cens(*, C: NDArray[Any], fmin: Optional[float] = None, n_chroma: int = 12, bins_per_octave: int = 36, window: Optional[NDArray[Any]] = None, norm: Optional[float] = 2, win_len_smooth: Optional[int] = 41, smoothing_window: Any = "hann") -> NDArray[Any]: ...
def chroma_vqt(*, V: NDArray[Any], fmin: Optional[float] = None, norm: Optional[float] = ..., threshold: Optional[float] = 0.0, bins_per_octave: int = 12) -> NDArray[Any]: ...
